<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eastequity.grok-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/eastonryan/east-equity-agent/scripts/grok_slot.sh</string>
    <string>watchdog</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/eastonryan/east-equity-agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <key>PATH</key>
    <string>/Users/eastonryan/.grok/bin:/Users/eastonryan/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Every hour at :15. The script stands down outside weekday 07:15–19:15 ET. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/eastonryan/east-equity-agent/logs/grok-watchdog-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/eastonryan/east-equity-agent/logs/grok-watchdog-launchd.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
