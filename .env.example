# Copy to .env and fill in. Never commit .env.
FRED_API_KEY=            # free: https://fred.stlouisfed.org/docs/api/api_key.html
# POLYGON_API_KEY=       # optional upgrade over yfinance later
# FINNHUB_API_KEY=       # optional news upgrade (free tier 60 calls/min): https://finnhub.io
# Moomoo (Phase 3 — requires OpenD gateway running locally)
# MOOMOO_HOST=127.0.0.1
# MOOMOO_PORT=11111
# MOOMOO_TRD_ENV=SIMULATE
# X (Twitter) auto-posting - developer app keys with write access (free tier OK)
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
